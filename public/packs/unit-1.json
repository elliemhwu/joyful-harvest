    { "id": "w-pretend", "kind": "word", "text": "pretend", "pos": "v.", "zh": "假裝", "level": 3, "official": true, "example": "He pretended to be asleep." },
    { "id": "p-walk-over", "kind": "phrase", "text": "walk over", "zh": "走過來；走過去", "level": 2, "example": "The teacher walked over to my desk." },
